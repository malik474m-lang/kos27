{
  "expo": {
    "name": "Космозайм",
    "slug": "kosmozaim",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "kosmozaim",
    "splash": {
      "backgroundColor": "#1a56db"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.kosmozaim.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#1a56db"
      },
      "package": "ru.kosmozaim.app"
    },
    "extra": {
      "apiBaseUrl": "https://kosmozaim.ru"
    }
  }
}
